# Required explicit runtime identity. Local and preview environments must use a
# separately declared backend unless canonical non-production access is deliberately enabled.
CREATIVE_OS_RUNTIME_CONTEXT=local
CREATIVE_OS_SCHEMA_CONTRACT_VERSION=1
CREATIVE_OS_MUTATION_AUTHORITY=creative-os-api
CREATIVE_OS_ALLOW_CANONICAL_NON_PRODUCTION=false

# Optional local development impersonation. It is honored only when
# CREATIVE_OS_RUNTIME_CONTEXT=local and requires an existing local profile.
# It is ignored in production, deploy previews, and branch deploys.
CREATIVE_OS_LOCAL_OWNER_MODE=false

# Supabase Dashboard: project Connect dialog or Settings -> API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project reference from the dashboard URL: /project/YOUR_PROJECT_REF
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Preferred: sb_publishable_...  Legacy equivalent: anon key.
# This value is safe for the signed-upload browser client, but it grants no table access by itself.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Preferred: sb_secret_...  Legacy equivalent: service_role key.
# SERVER ONLY. Never expose this value in browser code or a PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_LEGACY_SERVICE_ROLE_KEY

# The SQL migration creates these as private buckets.
SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts
SUPABASE_STORAGE_BUCKET_EXPORTS=exports
SUPABASE_STORAGE_BUCKET_IMPORTS_RAW=imports-raw
SUPABASE_STORAGE_BUCKET_IMPORTS_PROCESSED=imports-processed
SUPABASE_STORAGE_BUCKET_THUMBNAILS=thumbnails

# Optional when the repository is already linked through .netlify/state.json.
NETLIFY_SITE_ID=

# Used by npm run setup:verify. Use the deployed site origin, without a trailing slash.
CREATIVE_OS_SITE_URL=https://YOUR-SITE.netlify.app

# Optional and temporary for CLI role verification. Do not save a long-lived token here.
# NETLIFY_IDENTITY_TOKEN=

{
  "name": "reath-digest-ingester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint netlify/reath-functions netlify/functions/_shared/reath netlify/functions/reath-api.mjs netlify/functions/reath-ingest-background.mjs netlify/functions/reath-ai-background.mjs supabase/functions src/scripts/reath-auth-client.js src/scripts/reath-wire-client.js src/scripts/reath-wire-data.js src/scripts/reath-health-client.js src/scripts/reath-ai-client.js scripts/generate-nj-geography.mjs scripts/reath-ingester.test.mjs scripts/reath-ai.test.mjs scripts/reath-signal.test.mjs scripts/reath-reconciliation.test.mjs scripts/reath-edge-runtime.test.mjs scripts/reath-reconcile-stories.mjs scripts/reath-wire.test.mjs scripts/reath-wire-client.test.mjs scripts/reath-database-check.mjs scripts/sync-reath-edge-runtime.mjs",
    "typecheck": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "test:reath": "node --test scripts/reath*.test.mjs",
    "db:check": "node scripts/reath-database-check.mjs",
    "edge:sync": "node scripts/sync-reath-edge-runtime.mjs",
    "edge:check": "node scripts/sync-reath-edge-runtime.mjs --check",
    "stories:reconcile": "node scripts/reath-reconcile-stories.mjs",
    "exports": "node scripts/generate-exports.mjs",
    "repo:manifest": "node scripts/generate-import-manifest.mjs",
    "test:operations": "node --test scripts/operations-api.test.mjs",
    "test:auth": "node --test scripts/auth-api.test.mjs",
    "test:budget": "node --test scripts/request-budget.test.mjs",
    "budget:report": "node scripts/request-budget-report.mjs",
    "test:supabase": "node --test scripts/supabase-api.test.mjs scripts/setup-automation.test.mjs",
    "test:migration-policy": "node --test scripts/production-migration-policy.test.mjs",
    "supabase:migrate:production": "node scripts/deploy-production-migrations.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "setup:netlify": "node scripts/setup-netlify.mjs",
    "setup:import": "node scripts/setup-import.mjs",
    "setup:import:apply": "node scripts/setup-import-apply.mjs",
    "setup:verify": "node scripts/setup-verify.mjs",
    "supabase:seed": "node scripts/import-supabase.mjs",
    "supabase:seed:dry": "node scripts/import-supabase.mjs --dry-run",
    "supabase:seed:apply": "node scripts/import-supabase.mjs --apply",
    "supabase:files:dry": "node scripts/import-workspace-files.mjs",
    "supabase:files": "node scripts/import-workspace-files.mjs",
    "supabase:files:apply": "node scripts/import-workspace-files.mjs --apply",
    "build": "astro check && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@netlify/identity": "^1.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "astro": "^5.9.3",
    "fast-xml-parser": "5.11.0",
    "gray-matter": "^4.0.3",
    "openai": "7.5.0",
    "typescript": "^5.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "eslint": "10.9.0"
  }
}

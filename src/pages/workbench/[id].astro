---
import { getCollection } from "astro:content";
import AppLayout from "../../layouts/AppLayout.astro";
import Pill from "../../components/Pill.astro";
import { getBacklog } from "../../lib/backlog";

export async function getStaticPaths() {
  return getBacklog().map((item) => ({ params: { id: item.id.toLowerCase() }, props: { item } }));
}

const { item } = Astro.props;
const archive = await getCollection("archive");
const artifacts = await getCollection("artifacts");
const bundles = await getCollection("exportBundles");
const changes = await getCollection("changeLog");
const linked = archive.filter((entry) => entry.data.remediationTasks.includes(item.id) || entry.data.openDecisions.includes(item.id));
const siblings = getBacklog().filter((task) => task.category === item.category && task.id !== item.id).slice(0,5);
const decisionPage = item.category === "Decision Log Items";
const linkedIds = linked.map((entry)=>entry.id);
const relatedArtifacts = artifacts.filter((entry)=>entry.data.relatedTasks.includes(item.id) || entry.data.relatedArchiveRecords.some((id)=>linkedIds.includes(id)));
const decisionHistory = changes.filter((entry)=>entry.data.relatedDecision === item.id);
const affectedBundles = bundles.filter((bundle)=>{
  if (["DEC-09","DEC-10"].includes(item.id)) return bundle.data.includedProjects.some((project)=>/para/i.test(project));
  if (["DEC-06","DEC-07"].includes(item.id)) return /faction|canon|full/i.test(bundle.data.id);
  if (item.id === "DEC-11") return /artifact|public|full/i.test(bundle.data.id);
  return /decision|full|canon/i.test(bundle.data.id);
});
const affectedBundleIds = affectedBundles.map((bundle)=>bundle.data.id);
const knownRisks = [...new Set([...linked.flatMap((entry)=>entry.data.riskFlags), ...relatedArtifacts.flatMap((entry)=>entry.data.riskFlags)])];
const sourceFiles = [...new Set([...linked.flatMap((entry)=>entry.data.sourceArtifacts), ...relatedArtifacts.map((entry)=>entry.data.filePath)])];
const automaticBoundary = item.id === "DEC-01" ? "Structured names, aliases, search metadata, links, and safe references can be proposed automatically. Raw source artifacts remain unchanged." : "Structured metadata, relationship IDs, status labels, and generated exports can be proposed after the affected-file list is explicit.";
const humanBoundary = /legal|historical|rights|ethics/i.test(`${item.workType} ${item.problem}`) ? "Legal, monetization, historical transformation, cultural interpretation, and prose voice require human review." : "Narrative prose, ambiguous canon claims, and changes whose scope cannot be proven require human review.";
const criticalDecision = item.priority === "Critical" || decisionPage || /foundation|canon|legal|monetization|public/i.test(`${item.workType} ${item.problem}`);
---
<AppLayout title={`${item.id} ${item.title}`} section="workbench">
  <header class="detail-head"><div><p class="eyebrow">{item.category} · {item.id}</p><h1>{item.title}</h1><p class="lede">{item.problem}</p><div class="card-meta"><Pill label={item.priority} tone={item.priority}/>{item.needsDecision.startsWith("Yes")&&<Pill label="needs user decision" tone="flag"/>}</div></div><aside class="detail-rail"><dl><dt>Work type</dt><dd>{item.workType}</dd><dt>Decision gate</dt><dd>{item.needsDecision}</dd><dt>Required output</dt><dd>{item.output}</dd><dt>Canonical state</dt><dd>Open · backlog source</dd></dl></aside></header>
  <div class="detail-grid">
    <article class="prose"><h2>Issue explanation</h2><p>{item.problem}</p><h2>Why it matters</h2><p>{item.why}</p><h2>Recommended fix</h2><p>{item.fix}</p><h2>Affected concepts and files</h2><p>{item.affected}</p>
      {decisionPage&&<><h2>Affected source material</h2>{sourceFiles.length?<ul>{sourceFiles.map((file)=><li><code>{file}</code></li>)}</ul>:<p>No structured source-file links are available yet.</p>}<h2>Known risks</h2>{knownRisks.length?<div class="card-meta">{knownRisks.map((risk)=><Pill label={risk} tone="flag"/>)}</div>:<p>No explicit risk flags are linked; that is not clearance.</p>}</>}
      <h2>Source rewrite boundary</h2><p><b>Structured proposal:</b> {automaticBoundary}</p><p><b>Human review boundary:</b> {humanBoundary}</p><blockquote>Done means: {item.output}</blockquote>
    </article>
    <aside class="side-stack"><section class="card"><div class="card-kicker">Connected archive records</div>{linked.length?<ul class="mini-list">{linked.map((entry)=><li><a href={`/archive/${entry.id}`}>{entry.data.title}</a></li>)}</ul>:<p class="empty">No structured archive records link here yet.</p>}</section><section class="card"><div class="card-kicker">Related artifacts</div>{relatedArtifacts.length?<ul class="mini-list">{relatedArtifacts.map((entry)=><li><b>{entry.data.title}</b><br/>{entry.data.reviewStatus} · {entry.data.rightsStatus}</li>)}</ul>:<p class="empty">No artifact records link here yet.</p>}</section><section class="card"><div class="card-kicker">Related remediation tasks</div><ul class="mini-list">{siblings.map((task)=><li><a href={`/workbench/${task.id.toLowerCase()}`}><b>{task.id}</b><br/>{task.title}</a></li>)}</ul></section><section class="card"><div class="card-kicker">Legacy resolution history</div>{decisionHistory.length?<ul class="mini-list">{decisionHistory.map((entry)=><li><b>{entry.data.timestamp}</b><br/>{entry.data.summary} · {entry.data.status}</li>)}</ul>:<p class="empty">No static legacy resolution exists.</p>}</section><section class="card decision-card"><div class="card-kicker">Governance note</div><p>Resolution submissions are stored in Supabase immediately. Record-only decisions do not change source prose; high-risk canon, foundation, legal, public, and rewrite actions still enter Admin review.</p></section></aside>
  </div>
  <section class="decision-action" data-decision-panel>
    <div class="card-kicker">Resolution Panel · Database workflow</div><h2>Resolve this issue and trigger system work</h2><p class="lede">Choose the resolution, affected records/files, source impact, and follow-up. Submission creates a Supabase decision-resolution row and audit event—never a routine GitHub PR.</p>
    <div class="resolution-state" data-resolution-state><b>Canonical state</b><span>No submitted resolution in this browser. The backlog issue remains canonical.</span></div>
    <div class="form-grid"><label>Resolution option<select name="resolution"><option value="recommended">Choose recommended fix</option><option value="preserve">Preserve current state</option><option value="custom">Write custom resolution</option></select></label><label>Employee / person<input name="actor" required/></label></div>
    <label>Custom resolution<textarea name="custom" rows="3" placeholder="Required for a custom resolution"></textarea></label><label>Reason / rationale<textarea name="reason" rows="3" placeholder="Why this resolution is appropriate" required></textarea></label>
    <div class="form-grid"><fieldset><legend>Affected archive records</legend><div class="editable-chips">{linkedIds.length?linked.map((entry)=><label class="tag-check"><input type="checkbox" name="affectedRecord" value={entry.id} checked/><span>{entry.data.title}</span></label>):<span class="empty">No linked records; the issue ID will be recorded.</span>}</div></fieldset><fieldset><legend>Affected source files</legend><div class="editable-chips">{sourceFiles.length?sourceFiles.map((file)=><label class="tag-check"><input type="checkbox" name="affectedSourceFile" value={file}/><span>{file}</span></label>):<span class="empty">No source files linked.</span>}</div></fieldset><fieldset><legend>Affected exports</legend><div class="editable-chips">{affectedBundles.map((bundle)=><label class="tag-check"><input type="checkbox" name="affectedExport" value={bundle.data.id} checked/><span>{bundle.data.title}</span></label>)}</div></fieldset></div>
    <div class="form-grid"><label>Canon status result<select name="canonStatusResult"><option value="">No canon-status change</option><option value="strong-direction">Strong direction</option><option value="flexible-inspiration">Flexible inspiration</option><option value="experimental">Experimental</option><option value="retired">Retired</option><option value="foundation-canon">Foundation canon · review required</option></select></label><label>Review status result<select name="reviewStatusResult"><option value="proposed-resolution">Proposed resolution</option><option value="needs-review">Needs review</option><option value="classified">Classified</option><option value="resolved">Resolved after database apply</option></select></label></div>
    <div class="editable-chips"><label class="tag-check"><input type="checkbox" name="generateRewrite"/><span>Request later source rewrite</span></label><label class="tag-check"><input type="checkbox" name="followUp" checked/><span>Create follow-up task requirement</span></label></div>
    {criticalDecision&&<p class="warning-panel">Review required: this is critical, canon/foundation-sensitive, legal/monetization-sensitive, public-facing, or source-impacting. Owner/admin authority is recorded, but does not silently make it canonical.</p>}
    <div class="action-row"><button class="button secondary" type="button" data-preview-decision>Preview resolution</button><button class="button acid" type="button" data-submit-decision>Submit resolution</button><button class="button secondary" type="button" data-rewrite-plan>Submit rewrite request</button><button class="button secondary" type="button" data-export-decision>Export decision record</button><span class="save-state" aria-live="polite"></span></div><pre class="change-preview" hidden></pre>
  </section>
  <script is:inline define:vars={{decisionId:item.id,recommendation:item.fix,output:item.output,affectedBundleIds,automaticBoundary,humanBoundary,criticalDecision,workType:item.workType}}>
    const panel=document.querySelector('[data-decision-panel]'),preview=panel.querySelector('.change-preview'),state=panel.querySelector('.save-state'),resolutionState=panel.querySelector('[data-resolution-state]');
    const checked=name=>[...panel.querySelectorAll(`[name="${name}"]:checked`)].map(input=>input.value);
    const build=(action='decision.resolve')=>{const selected=panel.querySelector('[name="resolution"]').value,custom=panel.querySelector('[name="custom"]').value.trim(),actor=panel.querySelector('[name="actor"]').value.trim(),reason=panel.querySelector('[name="reason"]').value.trim(),affectedArchiveRecords=checked('affectedRecord'),affectedSourceFiles=checked('affectedSourceFile'),affectedExports=checked('affectedExport'),generateRewrite=panel.querySelector('[name="generateRewrite"]').checked,followUp=panel.querySelector('[name="followUp"]').checked,canonStatusResult=panel.querySelector('[name="canonStatusResult"]').value,reviewStatusResult=panel.querySelector('[name="reviewStatusResult"]').value;const resolution={selected,custom:selected==='recommended'?recommendation:selected==='preserve'?'Preserve current state':custom};const sourceImpact=['decision-record'];if(affectedArchiveRecords.length)sourceImpact.push('archive-records-proposed');if(generateRewrite)sourceImpact.push('source-files-proposed');if(affectedExports.length)sourceImpact.push('generated-exports-requested');return{action,operationType:action==='rewrite.plan'?'source_rewrite_request':'decision_resolution',decisionId,actor,submittedBy:actor,reason,rationale:reason,summary:`${action==='rewrite.plan'?'Request source rewrite for':'Resolve'} ${decisionId}: ${resolution.custom}`,targets:affectedArchiveRecords.length?affectedArchiveRecords:[decisionId],affectedArchiveRecords,affectedSourceFiles,affectedFiles:affectedSourceFiles,affectedExports,resolution,statusBefore:'open',statusAfter:reviewStatusResult,canonStatusResult,reviewStatusResult,workType,criticalDecision:criticalDecision||canonStatusResult==='foundation-canon',sourceImpact,followUpNeeded:followUp,followUpTasks:followUp?[output]:[],followUp:followUp?[output]:[],rewritePlan:generateRewrite?{automatic:automaticBoundary,humanReview:humanBoundary,preserveRawSources:true}:null};};
    const show=data=>{preview.textContent=JSON.stringify(data,null,2);preview.hidden=false;};
    const showResolution=(payload,result)=>{const label=window.CreativeOperations.stateLabel(result),sourceChanged=Boolean(result.sourceFilesChanged||result.decisionResolution?.source_files_changed),decisionRecordCreated=Boolean(result.decisionResolution?.id),rewriteRequested=Boolean(payload.rewritePlan),reviewPending=Boolean(result.reviewRequestId);resolutionState.innerHTML='';const heading=document.createElement('b'),intent=document.createElement('span'),list=document.createElement('ul');heading.textContent=`Resolution · ${label}`;intent.textContent=payload.resolution.custom;[["Decision-resolution record created",decisionRecordCreated],["Admin review pending",reviewPending],["Source rewrite requested",rewriteRequested],["Source rewrite applied",sourceChanged],["Canonical archive data changed",result.canonicalEffect==='structured archive records changed'],["Database state persisted",Boolean(result.databaseWriteApplied||result.reviewRequestId)]].forEach(([name,value])=>{const li=document.createElement('li');li.textContent=`${name}: ${value?'yes':'no'}`;list.append(li);});const detail=document.createElement('small');detail.textContent=sourceChanged?'Source rewrite was reported as applied.':decisionRecordCreated?'Decision recorded in Supabase. Source prose has not changed.':'Resolution was not stored; canonical state is unchanged.';resolutionState.append(heading,intent,list,detail);if(result.error){const error=document.createElement('strong');error.className='operation-error';error.textContent=result.error;resolutionState.append(error);}localStorage.setItem(`creative-os-resolution-${decisionId}`,JSON.stringify({payload,result}));};
    panel.querySelector('[data-preview-decision]').addEventListener('click',()=>show(build()));
    panel.querySelector('[data-submit-decision]').addEventListener('click',async()=>{const payload=build();if(!payload.actor||!payload.reason||(payload.resolution.selected==='custom'&&!payload.resolution.custom)){state.textContent='Person, rationale, and any custom resolution are required.';return;}state.textContent='Submitting…';const result=await window.CreativeOperations.submit(payload);show(result);showResolution(payload,result);window.CreativeOperations.renderStatus(state,result);});
    panel.querySelector('[data-rewrite-plan]').addEventListener('click',async()=>{const payload=build('rewrite.plan');if(!payload.actor||!payload.reason){state.textContent='Person and rationale are required.';return;}if(!payload.rewritePlan){state.textContent='Enable “Request later source rewrite” first.';return;}const result=await window.CreativeOperations.submit(payload);show(result);window.CreativeOperations.renderStatus(state,result);});
    panel.querySelector('[data-export-decision]').addEventListener('click',()=>{const data=build(),blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`${decisionId.toLowerCase()}-resolution.json`;a.click();URL.revokeObjectURL(url);state.textContent='Resolution exported locally; canonical source is unchanged.';});
    window.addEventListener('DOMContentLoaded',()=>{try{const saved=JSON.parse(localStorage.getItem(`creative-os-resolution-${decisionId}`)||'null');if(saved&&window.CreativeOperations)showResolution(saved.payload,saved.result);}catch{}});
  </script>
</AppLayout>

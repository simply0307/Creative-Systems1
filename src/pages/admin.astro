---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Admin Portal" section="admin">
  <header class="page-head"><div class="head-copy"><p class="eyebrow">Workbench / database review</p><h1>Admin Portal</h1><p class="lede">Review employee proposals and inspect the append-only audit trail. Approval applies the database change; an audit event only records what happened.</p></div></header>
  <section id="admin-guard" class="warning-panel"><h2>Checking admin access…</h2><p>Only trusted Netlify Identity <code>admin</code> and <code>owner</code> roles can use these controls.</p></section>
  <div id="admin-portal" hidden>
    <div class="metric-grid admin-metrics"><article><span>Pending review</span><b data-metric="pending_review">0</b></article><article><span>Changes requested</span><b data-metric="changes_requested">0</b></article><article><span>Applied</span><b data-metric="applied">0</b></article><article><span>Rejected</span><b data-metric="rejected">0</b></article><article><span>Failed</span><b data-metric="failed">0</b></article><article><span>Audit events</span><b data-metric="audits">0</b></article></div>
    <section class="card queue-diagnostics"><div class="card-kicker">Live diagnostics</div><dl><dt>Supabase queue loaded</dt><dd data-diag="loaded">no</dd><dt>Supabase configured</dt><dd data-diag="configured">no</dd><dt>Pending requests</dt><dd data-diag="pending">0</dd><dt>Failed requests</dt><dd data-diag="failed">0</dd><dt>Audit events loaded</dt><dd data-diag="audits">0</dd><dt>Routine GitHub PRs</dt><dd>disabled</dd><dt>Errors</dt><dd data-diag="errors">none</dd></dl></section>
    <div class="toolbar admin-toolbar"><input id="admin-search" type="search" placeholder="Intent, reason, submitter, artifact…"/><select id="admin-status"><option value="all">All workflow states</option><option value="pending_review">Pending review</option><option value="changes_requested">Changes requested</option><option value="failed">Failed</option><option value="applied">Applied</option><option value="rejected">Rejected</option><option value="cancelled">Cancelled</option></select><select id="admin-risk"><option value="all">All risk levels</option><option value="low">Low risk</option><option value="medium">Medium risk</option><option value="high">High risk</option></select><button class="button secondary" id="admin-refresh" type="button">Refresh database queue</button></div>
    <div id="admin-results"></div>
    <div id="admin-empty" class="empty-panel" hidden>No pending approvals. To test this queue, log in as contributor, add a harmless artifact tag, then return here as admin/owner.</div>
    <section class="card" id="controlled-values">
      <div class="section-heading"><div><div class="card-kicker">Organization controls</div><h2>Manage categories and tags</h2><p>Renames preserve stable IDs and artifact relationships. Archive values instead of deleting history.</p></div></div>
      <div class="detail-grid">
        <div><h3>Categories</h3><form data-create-controlled="categories" class="action-row"><input name="name" required placeholder="New category"/><button class="button acid" type="submit">Create</button><span class="save-state"></span></form><div id="managed-categories" class="compact-list"></div></div>
        <div><h3>Tags and metadata values</h3><form data-create-controlled="tags" class="action-row"><input name="name" required placeholder="New tag"/><select name="tagType"><option>freeform</option><option>style</option><option>entity</option><option>project</option><option>function</option><option>medium</option><option>rights</option><option>review</option><option>canon</option><option>visibility</option><option>workflow</option></select><button class="button acid" type="submit">Create</button><span class="save-state"></span></form><div id="managed-tags" class="compact-list"></div></div>
      </div>
    </section>
    <section class="queue-group"><h2>Recent audit history <span id="audit-count">0</span></h2><div id="audit-results"></div></section>
  </div>
  <script is:inline>
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(character)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]));
    const guard=document.querySelector('#admin-guard'),portal=document.querySelector('#admin-portal'),results=document.querySelector('#admin-results'),auditResults=document.querySelector('#audit-results'),empty=document.querySelector('#admin-empty');let requests=[],audits=[],organizationOptions={managedCategories:[],managedTags:[]};
    const groups=[['pending_review','Pending review'],['changes_requested','Changes requested'],['failed','Failed'],['applied','Applied / live'],['rejected','Rejected'],['cancelled','Cancelled']];
    const actionButtons=(item)=>{
      if(['pending_review','changes_requested','failed'].includes(item.status))return `<button class="button acid" data-action="approve">Approve & apply</button><button class="button secondary" data-action="reject">Reject</button><button class="button secondary" data-action="request_changes">Request changes</button><button class="button secondary" data-action="add_note">Add note</button>`;
      return `<button class="button secondary" data-action="add_note">Add note</button>`;
    };
    const card=(item)=>{const submitter=item.submitted_by_profile||{},before=JSON.stringify(item.before_snapshot||{},null,2),after=JSON.stringify(item.after_snapshot||{},null,2),fileEffect=item.operation_type==='artifact_upload'?'Storage object uploaded; artifact review controls visibility.':item.operation_type==='decision_resolution'?'Decision record exists; source prose changes only if sourceFilesChanged is true.':'Structured database metadata only.';return `<article class="operation-row" data-review-id="${esc(item.id)}"><div class="operation-row-main"><span class="queue-status ${esc(item.status)}">${esc(item.status.replaceAll('_',' '))}</span><span class="pill ${item.risk_level==='high'?'flag':''}">${esc(item.risk_level)} risk</span><div><b>${esc(item.operation_type.replaceAll('_',' '))}</b><p>${esc(item.intent_summary)}</p>${item.error_message?`<p class="operation-error">${esc(item.error_message)}</p>`:''}</div><small>${esc(submitter.display_name||submitter.email||'Unknown')} · ${esc(submitter.role||'unknown role')}<br/>${esc(new Date(item.created_at).toLocaleString())}</small><button class="button secondary" data-expand type="button">Details</button></div><div class="operation-details" hidden><div class="intent-reason"><div><b>Intent</b><p>${esc(item.intent_summary)}</p></div><div><b>Reason</b><p>${esc(item.reason||'No rationale supplied.')}</p></div><div><b>Source / canonical effect</b><p>${esc(fileEffect)}</p><p>${item.status==='applied'?'Database change is live now.':'Canonical database rows are unchanged until approval is applied.'}</p></div></div><div class="before-after"><section><b>Before</b><pre>${esc(before)}</pre></section><section><b>After / proposal</b><pre>${esc(after)}</pre></section></div><p><b>Affected artifacts:</b> ${esc((item.affected_artifacts||[]).join(' · ')||'None')}</p><p><b>Affected records:</b> ${esc((item.affected_records||[]).join(' · ')||'None')}</p><p><b>Affected files:</b> ${esc((item.affected_files||[]).join(' · ')||'None')}</p><label>Admin note<textarea data-note rows="2" placeholder="Required for rejection or changes requested"></textarea></label><div class="action-row">${actionButtons(item)}<span class="save-state"></span></div></div></article>`;};
    const filtered=()=>{const query=document.querySelector('#admin-search').value.trim().toLowerCase(),status=document.querySelector('#admin-status').value,risk=document.querySelector('#admin-risk').value;return requests.filter((item)=>(status==='all'||item.status===status)&&(risk==='all'||item.risk_level===risk)&&(!query||JSON.stringify(item).toLowerCase().includes(query)));};
    const render=()=>{const items=filtered(),visibleGroups=groups.map(([status,label])=>[status,label,items.filter((item)=>item.status===status)]).filter(([, ,values])=>values.length);results.innerHTML=visibleGroups.map(([,label,values])=>`<section class="queue-group"><h2>${label} <span>${values.length}</span></h2>${values.map(card).join('')}</section>`).join('');empty.hidden=requests.some((item)=>['pending_review','changes_requested','failed'].includes(item.status));groups.forEach(([status])=>{const metric=document.querySelector(`[data-metric="${status}"]`);if(metric)metric.textContent=requests.filter((item)=>item.status===status).length;});document.querySelector('[data-metric="audits"]').textContent=audits.length;document.querySelector('#audit-count').textContent=audits.length;auditResults.innerHTML=audits.slice(0,100).map((audit)=>`<article class="audit-row"><span>${esc(audit.result.replaceAll('_',' '))}</span><div><b>${esc(audit.intent_summary)}</b><small>${esc(audit.actor_email||'system')} · ${esc(audit.actor_role)} · ${esc(new Date(audit.created_at).toLocaleString())}</small></div><code>${esc(audit.action_type)}</code>${['applied','decision_recorded'].includes(audit.result)?`<button class="button secondary" data-revert-audit="${esc(audit.id)}">Create revert request</button>`:''}</article>`).join('')||'<p class="empty">No audit events yet.</p>';};
    const controlledRow=(kind,item)=>`<article class="audit-row ${item.is_active===false?'muted':''}" data-controlled-kind="${kind}" data-controlled-id="${esc(item.id)}"><span>${item.is_active===false?'archived':'active'}</span><div><b>${esc(kind==='tags'?`${item.tag_type} / ${item.name}`:item.name)}</b><small>${esc(item.slug)} · used by ${esc(item.usageCount||0)} artifact${item.usageCount===1?'':'s'}</small></div><button class="button secondary" data-controlled-action="rename">Rename</button><button class="button secondary" data-controlled-action="${item.is_active===false?'reactivate':'archive'}">${item.is_active===false?'Reactivate':'Archive'}</button></article>`;
    const renderControlledValues=()=>{document.querySelector('#managed-categories').innerHTML=(organizationOptions.managedCategories||[]).map((item)=>controlledRow('categories',item)).join('')||'<p>No categories yet.</p>';document.querySelector('#managed-tags').innerHTML=(organizationOptions.managedTags||[]).map((item)=>controlledRow('tags',item)).join('')||'<p>No tags yet.</p>';};
    const diagnostics=(data={},error=null)=>{const d=data.diagnostics||{};document.querySelector('[data-diag="loaded"]').textContent=d.databaseQueueLoaded?'yes':'no';document.querySelector('[data-diag="configured"]').textContent=d.supabaseConfigured?'yes':'no';document.querySelector('[data-diag="pending"]').textContent=d.pendingReviews??0;document.querySelector('[data-diag="failed"]').textContent=d.failed??0;document.querySelector('[data-diag="audits"]').textContent=d.auditEvents??0;document.querySelector('[data-diag="errors"]').textContent=error||'none';};
    const load=async()=>{await window.CreativeAccount.ready;const account=window.CreativeAccount.current();if(!['admin','owner'].includes(account.userRole)){guard.querySelector('h2').textContent=account.authenticated?'Admin Portal requires admin or owner role':'Log in as admin/owner to access Admin Portal';guard.hidden=false;portal.hidden=true;return;}guard.hidden=true;portal.hidden=false;try{const [data,options]=await Promise.all([window.CreativeDatabase.listReviews(),window.CreativeDatabase.organizationOptions()]);requests=data.requests||[];audits=data.audits||[];organizationOptions=options;diagnostics(data);render();renderControlledValues();}catch(error){diagnostics({},error.message);results.innerHTML=`<div class="warning-panel"><b>Admin queue unavailable</b><p>${esc(error.message)}</p></div>`;}};
    results.addEventListener('click',async(event)=>{const expand=event.target.closest('[data-expand]');if(expand){const details=expand.closest('.operation-row').querySelector('.operation-details');details.hidden=!details.hidden;expand.textContent=details.hidden?'Details':'Collapse';return;}const button=event.target.closest('[data-action]');if(!button)return;const row=button.closest('[data-review-id]'),item=requests.find((entry)=>entry.id===row.dataset.reviewId),action=button.dataset.action,note=row.querySelector('[data-note]').value.trim(),status=row.querySelector('.save-state');if(['reject','request_changes'].includes(action)&&!note){status.textContent='Add a note explaining this decision.';return;}status.textContent='Writing review decision to Supabase…';try{const response=await window.CreativeDatabase.reviewAction(item.id,action,note);if(action!=='add_note')item.status=response.reviewStatus||item.status;status.textContent=response.message;render();setTimeout(load,500);}catch(error){status.textContent=`Failed. ${error.message}`;item.status='failed';item.error_message=error.message;render();}});
    document.querySelector('#controlled-values').addEventListener('submit',async(event)=>{const form=event.target.closest('[data-create-controlled]');if(!form)return;event.preventDefault();const data=new FormData(form),status=form.querySelector('.save-state'),kind=form.dataset.createControlled;status.textContent='Creating…';try{await window.CreativeDatabase.createControlledValue(kind,{name:data.get('name'),tagType:data.get('tagType'),reason:'Admin controlled-value management'});form.reset();status.textContent='Created.';await load();}catch(error){status.textContent=error.message;}});
    document.querySelector('#controlled-values').addEventListener('click',async(event)=>{const button=event.target.closest('[data-controlled-action]');if(!button)return;const row=button.closest('[data-controlled-kind]'),kind=row.dataset.controlledKind,id=row.dataset.controlledId,action=button.dataset.controlledAction,payload={reason:'Admin controlled-value management'};if(action==='rename'){const current=row.querySelector('b').textContent.split(' / ').at(-1),name=window.prompt('Rename controlled value',current);if(!name?.trim())return;payload.name=name.trim();}else payload.isActive=action==='reactivate';button.disabled=true;try{await window.CreativeDatabase.updateControlledValue(kind,id,payload);await load();}catch(error){window.alert(error.message);}finally{button.disabled=false;}});
    auditResults.addEventListener('click',async(event)=>{const button=event.target.closest('[data-revert-audit]');if(!button)return;const reason=window.prompt('Why should this applied database change be reverted?');if(!reason)return;button.disabled=true;try{await window.CreativeDatabase.createRevert(button.dataset.revertAudit,reason);await load();}catch(error){window.alert(`Revert request failed: ${error.message}`);}finally{button.disabled=false;}});
    ['admin-search','admin-status','admin-risk'].forEach((id)=>document.querySelector(`#${id}`).addEventListener('input',render));document.querySelector('#admin-refresh').addEventListener('click',load);window.addEventListener('creative-os-auth-changed',load);window.addEventListener('DOMContentLoaded',load);
  </script>
</AppLayout>

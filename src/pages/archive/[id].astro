---
import { getCollection, render, type CollectionEntry } from "astro:content";
import AppLayout from "../../layouts/AppLayout.astro";
import Pill from "../../components/Pill.astro";
import { getBacklog, taskHref, type BacklogItem } from "../../lib/backlog";

export async function getStaticPaths() {
  const entries = await getCollection("archive");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const backlog = getBacklog();
const tasks = d.remediationTasks.map((id: string) => backlog.find((item) => item.id === id)).filter(Boolean) as BacklogItem[];
const decisions = d.openDecisions.map((id: string) => backlog.find((item) => item.id === id)).filter(Boolean) as BacklogItem[];
const related = d.relatedConcepts.map((id: string) => entries.find((item) => item.id === id)).filter(Boolean) as CollectionEntry<"archive">[];
---
<AppLayout title={d.title} section="archive" description={d.summary}>
  <header class="detail-head">
    <div>
      <p class="eyebrow">{d.entityType.replaceAll("-", " ")} · Version {d.version}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="card-meta"><Pill label={d.canonStatus} />{d.reviewFlags.map((flag) => <Pill label={flag} tone="flag" />)}</div>
    </div>
    <aside class="detail-rail">
      <dl>
        <dt>Reuse channels</dt><dd>{d.reuseCategories.join(" · ") || "Not mapped"}</dd>
        <dt>Project scope</dt><dd>{d.relatedProjects.join(" · ") || "Ecosystem / unresolved"}</dd>
        <dt>Open work</dt><dd>{tasks.length} remediation task{tasks.length === 1 ? "" : "s"} · {decisions.length} linked decision{decisions.length === 1 ? "" : "s"}</dd>
        <dt>Provenance note</dt><dd>{d.provenance}</dd>
      </dl>
    </aside>
  </header>
  <div class="detail-grid">
    <article class="prose"><Content /></article>
    <aside class="side-stack">
      <section class="card">
        <div class="card-kicker">Known problems / tasks</div>
        {tasks.length ? <ul class="mini-list">{tasks.map((task) => <li><a href={taskHref(task.id)}><span><b>{task.id}</b><br/>{task.title}</span><Pill label={task.priority} tone={task.priority} /></a></li>)}</ul> : <p class="empty">No linked remediation tasks.</p>}
      </section>
      <section class="card decision-card">
        <div class="card-kicker">Open decisions</div>
        {decisions.length ? <ul class="mini-list">{decisions.map((decision) => <li><a href={taskHref(decision.id)}><span><b>{decision.id}</b><br/>{decision.title}</span></a></li>)}</ul> : <p class="empty">No linked decision gates.</p>}
      </section>
      <section class="card">
        <div class="card-kicker">Related concepts</div>
        {related.length ? <ul class="mini-list">{related.map((item) => <li><a href={`/archive/${item.id}`}>{item.data.title}</a></li>)}</ul> : <p class="empty">No linked concepts yet.</p>}
      </section>
      <section class="card">
        <div class="card-kicker">Source artifacts</div>
        <ul class="mini-list">{d.sourceArtifacts.map((source) => <li>{source}</li>)}</ul>
      </section>
      {d.riskFlags.length > 0 && <section class="card risk-card"><div class="card-kicker">Risk flags</div><div class="card-meta">{d.riskFlags.map((risk) => <Pill label={risk} tone="flag" />)}</div></section>}
    </aside>
  </div>
</AppLayout>

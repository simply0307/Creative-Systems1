---
import AppLayout from "../../layouts/AppLayout.astro";
import PipelineNav from "../../components/PipelineNav.astro";
import { artifactOrganization } from "../../data/artifact-organization.mjs";
---
<AppLayout title="Import center" section="import">
  <PipelineNav active="import" />
  <header class="page-head"><div class="head-copy"><p class="eyebrow">Operations / Supabase intake</p><h1>Bring the existing archive into the live database.</h1><p class="lede">Import deployed repo metadata first, then attach the real local files with multi-file or folder selection. Supabase remains the operational source of truth; no GitHub PR is created.</p></div></header>

  <section class="card import-metadata-panel">
    <div><div class="card-kicker">Step 1 / Admin or owner</div><h2>Import existing repo metadata</h2><p>Creates or safely updates the deployed 16 artifact records, archive records, remediation decisions, tags, categories, and known relationships. It does not upload source file bytes.</p></div>
    <div class="action-row"><button id="repo-metadata-import" class="button acid" type="button">Import existing repo metadata</button><button id="refresh-import-status" class="button secondary" type="button">Refresh status</button><span id="metadata-import-status" class="save-state" aria-live="polite">Checking account and database…</span></div>
    <div id="metadata-import-result" class="operations-diagnostics" hidden></div>
  </section>

  <section class="card import-dashboard">
    <div class="section-heading"><div><div class="card-kicker">Live Supabase status</div><h2>Import coverage</h2></div><span data-import-manifest>Manifest loading…</span></div>
    <div class="metric-grid import-metrics">
      <article><span>Total artifacts</span><b data-import-metric="totalArtifacts">—</b></article>
      <article><span>Imported files</span><b data-import-metric="importedFiles">—</b></article>
      <article><span>Metadata only</span><b data-import-metric="metadataOnly">—</b></article>
      <article><span>Need upload</span><b data-import-metric="filesNeedingUpload">—</b></article>
      <article><span>Images</span><b data-import-metric="availableImages">—</b></article>
      <article><span>PDFs</span><b data-import-metric="availablePdfs">—</b></article>
      <article><span>Text docs</span><b data-import-metric="availableTextDocs">—</b></article>
      <article><span>Duplicate warnings</span><b data-import-metric="duplicateWarnings">—</b></article>
      <article><span>Failed batches</span><b data-import-metric="failedImports">—</b></article>
    </div>
    <div class="import-status-details"><details><summary>Expected repo files</summary><div id="expected-import-files" class="compact-list"></div></details><details><summary>Recent import batches</summary><div id="recent-import-batches" class="compact-list"></div></details><details><summary>Duplicate diagnostics</summary><div id="duplicate-import-warnings" class="compact-list"></div></details></div>
  </section>

  <div class="detail-grid import-workspace">
    <section class="card">
      <div class="card-kicker">Step 2 / Browser batch upload</div><h2>Attach the real Creative Systems files</h2><p>Select many files, or select an entire folder. Original relative paths and SHA-256 checksums are used to reconnect files to known metadata.</p>
      <form id="artifact-upload-form" class="upload-form">
        <div class="form-grid">
          <label>Choose multiple files<input name="files" type="file" multiple accept="image/*,application/pdf,text/*,.md,.markdown,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.json,.csv" /><small>Select individual files from one or more folders.</small></label>
          <label>Choose a folder<input name="folderFiles" type="file" multiple /><small>Best matching: choose the Archive or Creative Systems folder to preserve relative paths.</small></label>
        </div>
        <div class="form-grid">
          <label>Title override (single file)<input name="title" placeholder="Otherwise derived from filename" /></label>
          <label>Description<textarea name="description" rows="2" placeholder="Default description for this batch"></textarea></label>
          <label>Medium / artifact type<select name="artifactType" data-controlled-select="media"><option value="auto">Detect from file</option>{artifactOrganization.media.map((value) => <option value={value}>{value}</option>)}</select></label>
          <label>Project<select name="project" data-controlled-select="projects">{artifactOrganization.projects.map((value) => <option value={value} selected={value === "unassigned"}>{value}</option>)}</select></label>
          <label>Default category<select name="categoryId" data-import-category><option value="">Unassigned</option></select><button class="button secondary" type="button" data-import-create-category hidden>Create category</button></label>
          <label>Related entity / archive record<select name="relatedEntityId" data-import-entity><option value="">Unassigned</option></select></label>
          <label>Function / intended use<select name="intendedUse" data-controlled-select="functions">{artifactOrganization.functions.map((value) => <option value={value} selected={value === "unassigned"}>{value}</option>)}</select></label>
          <label>Rights status<select name="rightsStatus" data-controlled-select="rightsStatuses">{artifactOrganization.rightsStatuses.map((value) => <option value={value} selected={value === "needs-review"}>{value}</option>)}</select></label>
          <label>Review status<select name="reviewStatus" data-controlled-select="reviewStatuses">{artifactOrganization.reviewStatuses.map((value) => <option value={value} selected={value === "needs-tagging"}>{value}</option>)}</select></label>
          <label>Canon status<select name="canonStatus" data-controlled-select="canonStatuses">{artifactOrganization.canonStatuses.map((value) => <option value={value} selected={value === "draft"}>{value}</option>)}</select></label>
          <label>Visibility<select name="visibility" data-controlled-select="visibilities">{artifactOrganization.visibilities.map((value) => <option value={value} selected={value === "internal"}>{value}</option>)}</select></label>
          <label>Workflow status<select name="workflowStatus" data-controlled-select="workflowStatuses">{artifactOrganization.workflowStatuses.map((value) => <option value={value} selected={value === "uploaded"}>{value}</option>)}</select></label>
          <label>Tags<input type="search" data-import-tag-search placeholder="Search tags"/><select name="tagIds" multiple size="7" data-import-tags><option disabled>Load account to fetch tags</option></select><button class="button secondary" type="button" data-import-create-tag hidden>Create tag</button></label>
          <label>Notes<textarea name="notes" rows="2" placeholder="Internal organization notes"></textarea></label>
        </div>
        <label>Batch reason<textarea name="reason" rows="3" required placeholder="Where these files came from and why they are being imported"></textarea></label>
        <details><summary>AI provenance defaults</summary><div class="form-grid compact"><label>AI generated<select name="aiGenerated"><option value="unknown">Unknown</option><option value="false">No</option><option value="true">Yes</option></select></label><label>Model<input name="aiModel" /></label><label>Prompt used<textarea name="promptUsed" rows="2"></textarea></label></div></details>
        <div class="action-row"><button class="button acid" type="submit">Start batch upload</button><span class="save-state" aria-live="polite"></span></div>
      </form>
      <div id="upload-results" class="side-stack import-file-results"></div>
    </section>
    <aside class="side-stack">
      <section class="warning-panel"><div class="card-kicker">Matching order</div><ol class="mini-list"><li>SHA-256 checksum</li><li>Original relative path</li><li>Filename and size</li><li>Filename</li><li>Slug</li></ol><p>Ambiguous matches stop instead of creating a likely duplicate.</p></section>
      <section class="card pipeline-card acid"><div class="card-kicker">Role policy</div><h3>Imports are real changes.</h3><p>Admin and owner imports apply immediately and are audited. Contributor uploads create review requests. Static repo metadata import is restricted to admin/owner.</p><a class="button secondary" href="/admin">Open Admin Portal</a></section>
      <section class="card"><div class="card-kicker">File truth</div><ul class="mini-list"><li><b>Available:</b> private Storage object exists.</li><li><b>Needs upload:</b> metadata knows the expected local file.</li><li><b>Missing:</b> expected path was absent when the manifest was generated.</li><li><b>Metadata only:</b> no file is expected.</li></ul></section>
    </aside>
  </div>

  <script is:inline>
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(character)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[character]));
    const privileged=(role)=>['admin','owner'].includes(role);
    const detectType=(file)=>file.type.startsWith('image/')?'image':file.type==='application/pdf'?'pdf':/\.(md|markdown|mdx)$/i.test(file.name)?'markdown':file.type.startsWith('text/')||/\.(txt|json|csv|ya?ml)$/i.test(file.name)?'text':/\.(docx?|odt|rtf)$/i.test(file.name)?'doc':'other';
    const form=document.querySelector('#artifact-upload-form');
    form.elements.folderFiles.setAttribute('webkitdirectory','');form.elements.folderFiles.setAttribute('directory','');
    const formStatus=form.querySelector('.save-state');
    const results=document.querySelector('#upload-results');
    const metadataButton=document.querySelector('#repo-metadata-import');
    const metadataStatus=document.querySelector('#metadata-import-status');
    const metadataResult=document.querySelector('#metadata-import-result');
    const tasks=new Map();
    let organizationState={tags:[],categories:[],archiveRecords:[],values:{}};

    const fillControlledSelect=(select,items)=>{const current=select.value,auto=select.name==='artifactType'?'<option value="auto">Detect from file</option>':'';select.innerHTML=auto+items.map((value)=>`<option value="${esc(value)}">${esc(value)}</option>`).join('');select.value=[...select.options].some((option)=>option.value===current)?current:select.name==='artifactType'?'auto':items.includes('unassigned')?'unassigned':items[0]||'';};
    const applyOrganizationOptions=(options,role)=>{organizationState=options;document.querySelectorAll('[data-controlled-select]').forEach((select)=>fillControlledSelect(select,options.values?.[select.dataset.controlledSelect]||[]));document.querySelector('[data-import-category]').innerHTML='<option value="">Unassigned</option>'+options.categories.map((item)=>`<option value="${esc(item.id)}">${esc(item.name)}</option>`).join('');document.querySelector('[data-import-entity]').innerHTML='<option value="">Unassigned</option>'+options.archiveRecords.map((item)=>`<option value="${esc(item.id)}">${esc(item.title)} · ${esc(item.type)}</option>`).join('');document.querySelector('[data-import-tags]').innerHTML=options.tags.map((item)=>`<option value="${esc(item.id)}">${esc(`${item.tag_type} / ${item.name}`)}</option>`).join('');document.querySelector('[data-import-create-category]').hidden=!privileged(role);document.querySelector('[data-import-create-tag]').hidden=!privileged(role);};

    const refreshStatus=async()=>{
      await window.CreativeAccount.ready;
      const account=window.CreativeAccount.current();
      metadataButton.disabled=!privileged(account.userRole);
      metadataButton.title=privileged(account.userRole)?'':'Admin or owner role required';
      metadataStatus.textContent=!account.authenticated?'Log in to load import status.':privileged(account.userRole)?'Admin/owner import available.':'Repo metadata import requires admin or owner; file uploads follow your role policy.';
      if(!account.authenticated)return;
      try{
        const [payload,organizationOptions]=await Promise.all([window.CreativeDatabase.importStatus(),window.CreativeDatabase.organizationOptions()]);
        applyOrganizationOptions(organizationOptions,account.userRole);
        const status=payload.status;
        document.querySelector('[data-import-manifest]').textContent=`Repo manifest ${payload.manifest.version} · ${payload.manifest.counts.artifacts} artifact records expected`;
        document.querySelectorAll('[data-import-metric]').forEach((element)=>{const key=element.dataset.importMetric;element.textContent=key==='duplicateWarnings'?status.duplicateWarnings.length:status[key]??0;});
        const expected=document.querySelector('#expected-import-files');
        expected.innerHTML=status.expectedFiles.length?status.expectedFiles.map((file)=>`<div><b>${esc(file.title)}</b><span>${esc(file.originalPath||file.originalFileName)} · ${esc(file.status)}</span></div>`).join(''):'<p>Expected-file details are visible to admin/owner accounts.</p>';
        document.querySelector('#recent-import-batches').innerHTML=status.recentBatches.length?status.recentBatches.map((batch)=>`<div><b>${esc(batch.title)}</b><span>${esc(batch.status)} · ${esc(new Date(batch.created_at).toLocaleString())}</span></div>`).join(''):'<p>No import batches yet.</p>';
        document.querySelector('#duplicate-import-warnings').innerHTML=status.duplicateWarnings.length?status.duplicateWarnings.map((warning)=>`<div><b>${esc(warning.key)}</b><span>${esc(warning.artifactIds.join(', '))}</span></div>`).join(''):'<p>No checksum or name/size duplicates detected.</p>';
      }catch(error){metadataStatus.textContent=`Status failed: ${error.message}`;}
    };

    metadataButton.addEventListener('click',async()=>{
      const account=window.CreativeAccount.current();
      if(!privileged(account.userRole)){metadataStatus.textContent='Admin or owner role required.';return;}
      metadataButton.disabled=true;metadataStatus.textContent='Importing deployed repo metadata into Supabase…';metadataResult.hidden=true;
      try{
        const result=await window.CreativeDatabase.importRepoMetadata();
        metadataStatus.textContent=result.message;
        metadataResult.hidden=false;
        metadataResult.innerHTML=`<b>Manifest ${esc(result.manifestVersion)}</b><dl><dt>Created</dt><dd>${esc(result.totals.created)}</dd><dt>Updated</dt><dd>${esc(result.totals.updated)}</dd><dt>Skipped/current</dt><dd>${esc(result.totals.skipped)}</dd><dt>Import batch</dt><dd>${esc(result.importBatchId)}</dd><dt>Audit event</dt><dd>${esc(result.auditEventId)}</dd></dl><a class="button secondary" href="/pipeline/artifacts">Open Artifact Library</a>`;
        await refreshStatus();
      }catch(error){metadataStatus.textContent=`Import failed: ${error.message}`;metadataResult.hidden=false;metadataResult.textContent=error.response?.error||error.message;}
      finally{metadataButton.disabled=!privileged(window.CreativeAccount.current().userRole);}
    });
    document.querySelector('#refresh-import-status').addEventListener('click',refreshStatus);
    document.querySelector('[data-import-tag-search]').addEventListener('input',(event)=>{const query=event.currentTarget.value.trim().toLowerCase();[...document.querySelector('[data-import-tags]').options].forEach((option)=>{option.hidden=Boolean(query&&!option.textContent.toLowerCase().includes(query));});});
    document.querySelector('[data-import-create-category]').addEventListener('click',async()=>{const name=window.prompt('New category name');if(!name?.trim())return;try{await window.CreativeDatabase.createControlledValue('categories',{name:name.trim(),reason:'Created from Import Center'});await refreshStatus();}catch(error){window.alert(error.message);}});
    document.querySelector('[data-import-create-tag]').addEventListener('click',async()=>{const name=window.prompt('New tag name');if(!name?.trim())return;const tagType=window.prompt('Tag family (medium, project, entity, function, rights, review, canon, visibility, workflow, style, freeform)','freeform');if(!tagType?.trim())return;try{await window.CreativeDatabase.createControlledValue('tags',{name:name.trim(),tagType:tagType.trim().toLowerCase(),reason:'Created from Import Center'});await refreshStatus();}catch(error){window.alert(error.message);}});

    const rowFor=(task)=>{
      if(task.row)return task.row;
      const row=document.createElement('article');row.className='upload-result import-file-row';row.innerHTML=`<div class="import-file-head"><b>${esc(task.file.webkitRelativePath||task.file.name)}</b><span data-file-state>Queued</span></div><div class="import-progress"><i style="width:0%"></i></div><small data-file-detail>${esc(task.file.size.toLocaleString())} bytes</small><div class="action-row"><button type="button" class="button secondary retry-file" hidden>Retry</button><a data-file-open target="_blank" rel="noopener" hidden>Open stored file</a></div>`;results.append(row);task.row=row;row.querySelector('.retry-file').addEventListener('click',async()=>{await uploadOne(task);await window.CreativeDatabase.completeImportBatch(task.batchId);await refreshStatus();});return row;
    };
    const updateRow=(task,message,percent)=>{const row=rowFor(task);row.querySelector('[data-file-state]').textContent=message;row.querySelector('.import-progress i').style.width=`${Math.max(0,Math.min(100,percent))}%`;};
    const recordFileStatus=async(task,status,result,error)=>{
      try{await window.CreativeDatabase.updateImportFile(task.batchId,{clientFileId:task.id,fileName:task.file.name,relativePath:task.file.webkitRelativePath||task.file.name,fileSize:task.file.size,status,artifactId:result?.artifact?.id||null,matchedArtifactId:result?.matchedArtifactId||result?.artifact?.id||null,matchedBy:result?.matchedBy||null,error:error?.message||null});}catch(batchError){task.row.querySelector('[data-file-detail]').textContent+=` · batch log failed: ${batchError.message}`;}
    };
    const uploadOne=async(task)=>{
      const row=rowFor(task);row.classList.remove('failed-operation');row.querySelector('.retry-file').hidden=true;updateRow(task,'Starting',2);
      try{
        const result=await window.CreativeDatabase.uploadArtifact(task.file,{...task.metadata,importBatchId:task.batchId,relativePath:task.file.webkitRelativePath||task.file.name},(message)=>{const percent=Number(message.match(/(\d+)%/)?.[1]||10);updateRow(task,message,percent);formStatus.textContent=`Processing ${task.index+1}/${task.total} · ${message}`;});
        const state=result.duplicate?'duplicate':result.mode==='pending-review'?'pending_review':'applied';
        updateRow(task,result.duplicate?'Duplicate skipped':result.matchedExistingArtifact?`Matched existing metadata by ${result.matchedBy}`:window.CreativeDatabase.stateLabel(result),100);
        row.querySelector('[data-file-detail]').textContent=result.message;
        const link=row.querySelector('[data-file-open]');const url=result.artifact?.signedUrl||result.artifact?.downloadUrl;if(url){link.href=url;link.hidden=false;link.textContent='Open stored file';}
        await recordFileStatus(task,state,result,null);task.done=true;task.failed=false;
      }catch(error){task.failed=true;row.classList.add('failed-operation');updateRow(task,'Failed',100);row.querySelector('[data-file-detail]').textContent=error.message;row.querySelector('.retry-file').hidden=false;await recordFileStatus(task,'failed',null,error);}
    };

    form.addEventListener('submit',async(event)=>{
      event.preventDefault();await window.CreativeAccount.ready;const account=window.CreativeAccount.current();if(!account.authenticated){formStatus.textContent='Log in before uploading.';window.CreativeAccount.login();return;}
      const candidates=[...form.elements.files.files,...form.elements.folderFiles.files];const unique=new Map(candidates.map((file)=>[`${file.webkitRelativePath||file.name}:${file.size}:${file.lastModified}`,file]));const files=[...unique.values()];if(!files.length){formStatus.textContent='Choose files or a folder first.';return;}
      const data=new FormData(form);const selectedType=data.get('artifactType');const selectedTags=[...form.elements.tagIds.selectedOptions].map((option)=>organizationState.tags.find((tag)=>tag.id===option.value)).filter(Boolean).map((tag)=>({id:tag.id,name:tag.name,tagType:tag.tag_type}));const defaults={title:data.get('title'),description:data.get('description'),artifactType:selectedType,project:data.get('project'),intendedUse:data.get('intendedUse'),visibility:data.get('visibility'),rightsStatus:data.get('rightsStatus'),canonStatus:data.get('canonStatus'),reviewStatus:data.get('reviewStatus'),workflowStatus:data.get('workflowStatus'),controlledTags:selectedTags,categoryId:data.get('categoryId'),relatedEntityId:data.get('relatedEntityId'),notes:data.get('notes'),reason:data.get('reason'),aiGenerated:data.get('aiGenerated')==='unknown'?null:data.get('aiGenerated')==='true',aiModel:data.get('aiModel'),promptUsed:data.get('promptUsed')};
      form.querySelector('button[type="submit"]').disabled=true;results.innerHTML='';tasks.clear();formStatus.textContent=`Creating batch for ${files.length} files…`;
      try{
        const created=await window.CreativeDatabase.createImportBatch({title:`Browser import · ${new Date().toLocaleString()}`,fileCount:files.length,defaults,notes:defaults.reason});const batchId=created.importBatch.id;
        files.forEach((file,index)=>{const derivedTitle=file.name.replace(/\.[^.]+$/,'');const task={id:`${file.webkitRelativePath||file.name}:${file.size}`,file,index,total:files.length,batchId,metadata:{...defaults,title:files.length===1&&defaults.title?defaults.title:derivedTitle,artifactType:selectedType==='auto'?detectType(file):selectedType}};tasks.set(task.id,task);rowFor(task);});
        for(const task of tasks.values())await uploadOne(task);
        const complete=await window.CreativeDatabase.completeImportBatch(batchId);const failed=[...tasks.values()].filter((task)=>task.failed).length;formStatus.textContent=failed?`${complete.message} ${failed} file(s) can be retried below.`:complete.message;
        await refreshStatus();
      }catch(error){formStatus.textContent=`Batch failed: ${error.message}`;}
      finally{form.querySelector('button[type="submit"]').disabled=false;}
    });

    window.addEventListener('creative-os-auth-changed',refreshStatus);refreshStatus();
  </script>
</AppLayout>

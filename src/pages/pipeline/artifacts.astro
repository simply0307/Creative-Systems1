---
import AppLayout from "../../layouts/AppLayout.astro";
import PipelineNav from "../../components/PipelineNav.astro";
---
<AppLayout title="Archive folder index" section="artifacts">
  <PipelineNav active="artifacts" />

  <header class="page-head compact-head">
    <div class="head-copy">
      <p class="eyebrow">Archive</p>
      <h1>Your folder, searchable.</h1>
      <p class="lede">Browse the Desktop <code>Archive/</code> snapshot, preview available files, download individual files, and organize everything with folders, standard tags, and quick personal tags.</p>
    </div>
    <div class="count-orbit">
      <div><b id="shown-count">0</b><span>shown</span></div>
      <div><b id="total-count">0</b><span>indexed</span></div>
    </div>
  </header>

  <section class="index-actions">
    <article>
      <b>Archive folder</b>
      <span id="manifest-summary">Reading Archive folder snapshot...</span>
      <button class="button secondary" id="reload-index" type="button">Refresh view</button>
    </article>
    <article>
      <b>Import repository snapshot</b>
      <span>Admin/owner only. Adds missing repository-manifest metadata to canonical Creative OS; it does not upload source-file bytes.</span>
      <button class="button secondary" id="import-archive-snapshot" type="button" disabled>Review and import</button>
    </article>
    <article>
      <b>New folder</b>
      <span>Create a folder label for organizing files in this index.</span>
      <button class="button secondary" id="create-folder" type="button">Create folder</button>
    </article>
    <article>
      <b>Add files</b>
      <span>Upload new files or attach real file bytes to indexed Archive entries for preview and download.</span>
      <label class="button acid upload-button">Add files
        <input id="folder-upload" type="file" multiple />
      </label>
    </article>
    <article>
      <b>Status</b>
      <span id="index-status">Loading...</span>
    </article>
  </section>

  <section class="file-audit-summary" id="artifact-summary">
    <span><b data-count="available">0</b> available files</span>
    <span><b data-count="needs_import">0</b> need file copy</span>
    <span><b data-count="manifest_only">0</b> snapshot-only</span>
    <span><b data-count="folders">0</b> folders</span>
    <span><b data-count="folder_tags">0</b> folder tags</span>
    <span><b data-count="standard_tags">0</b> standard tags</span>
    <span><b data-count="freeform_tags">0</b> freeform tags</span>
  </section>

  <details class="bulk-index-panel" open>
    <summary>Bulk organize selected files - <b id="selected-count">0</b> selected</summary>
    <div class="bulk-grid">
      <div class="bulk-actions">
        <button class="button secondary" id="select-visible" type="button">Select visible database files</button>
        <button class="button secondary" id="clear-selection" type="button">Clear selection</button>
      </div>
      <label>Move to folder<select id="bulk-folder"><option value="">Choose folder</option></select></label>
      <button class="button acid" id="bulk-move" type="button">Move selected</button>
      <label>Standard tags<input id="bulk-standard-tags" list="standard-tag-values" placeholder="keeper, reference, needs-sort" /></label>
      <div class="bulk-actions">
        <button class="button secondary" id="bulk-add-standard" type="button">Add standard tags</button>
        <button class="button secondary" id="bulk-remove-standard" type="button">Remove standard tags</button>
      </div>
      <label>Freeform tags<input id="bulk-freeform-tags" list="freeform-tag-values" placeholder="favorite, revisit, weird" /></label>
      <div class="bulk-actions">
        <button class="button secondary" id="bulk-add-freeform" type="button">Add freeform tags</button>
        <button class="button secondary" id="bulk-remove-freeform" type="button">Remove freeform tags</button>
      </div>
    </div>
    <p id="bulk-status" class="bulk-status">Select files below, then move them or apply tags in one pass.</p>
  </details>

  <section class="folder-index-shell">
    <aside class="folder-rail">
      <div class="rail-head">
        <b>Folders</b>
        <button class="button secondary mini" data-folder="">All</button>
      </div>
      <div id="folder-list" class="folder-list"></div>
    </aside>

    <div class="index-main">
      <details class="library-controls" open>
        <summary>Search and filters - <b id="filter-count">0</b> results</summary>
        <div class="toolbar archive-toolbar">
          <label class="wide">Search<input id="artifact-search" type="search" placeholder="Filename, path, folder, tag, notes..." /></label>
          <label>Type<select data-filter="type"><option value="">All</option></select></label>
          <label>File state<select data-filter="file"><option value="">All</option><option value="available">Preview/download ready</option><option value="needs_import">Needs file copy</option><option value="manifest_only">Repository snapshot only</option><option value="metadata_only">Metadata only</option></select></label>
          <label>Folder<select data-filter="folder"><option value="">All</option></select></label>
          <label>Standard tag<select data-filter="standard"><option value="">All</option></select></label>
          <label>Freeform tag<select data-filter="freeform"><option value="">All</option></select></label>
          <button class="button secondary" id="clear-filters" type="button">Clear</button>
        </div>
      </details>

      <div id="upload-progress" class="upload-progress" hidden></div>
      <div id="artifact-grid" class="archive-index-grid"></div>
      <div id="artifact-empty" class="empty-panel" hidden>
        <b>No files match these filters.</b>
        <p>Clear filters or add a file to the Archive Index.</p>
      </div>
    </div>
  </section>

  <dialog id="text-preview-dialog" class="file-preview-dialog">
    <div class="dialog-head"><h2 data-preview-title>File preview</h2><button class="button secondary" type="button" data-close-preview>Close</button></div>
    <pre data-preview-content>Loading...</pre>
  </dialog>

  <script>import "../../scripts/archive-index-client.js";</script>

  <style>
    .compact-head code{font-size:.9em}.index-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1rem;margin:1rem 0}.index-actions article{display:grid;gap:.45rem;padding:1rem;border:1px solid var(--line);background:var(--paper)}
    .upload-button{position:relative;overflow:hidden;width:max-content}.upload-button input{position:absolute;inset:0;opacity:0;cursor:pointer}.bulk-index-panel{margin:1rem 0;padding:1rem;border:1px solid var(--line);background:var(--paper)}.bulk-index-panel summary{cursor:pointer;font-weight:700}.bulk-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.65rem;align-items:end;margin-top:.75rem}.bulk-grid label{display:grid;gap:.25rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}.bulk-actions{display:flex;flex-wrap:wrap;gap:.45rem}.bulk-status{margin:.75rem 0 0;font-size:.85rem}.select-file{display:flex;align-items:center;gap:.4rem;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}.folder-index-shell{display:grid;grid-template-columns:minmax(13rem,18rem) minmax(0,1fr);gap:1rem;align-items:start}.folder-rail{position:sticky;top:1rem;max-height:calc(100vh - 2rem);overflow:auto;border:1px solid var(--line);background:var(--paper);padding:.75rem}.rail-head{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.5rem}.mini{padding:.25rem .55rem}.folder-list{display:grid;gap:.25rem}.folder-list button{display:flex;justify-content:space-between;gap:.75rem;text-align:left;border:0;border-bottom:1px solid rgba(0,0,0,.08);background:transparent;padding:.45rem;cursor:pointer}.folder-list button.active{background:rgba(198,255,0,.28)}.folder-list span{overflow-wrap:anywhere}.archive-toolbar{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));align-items:end;gap:.65rem;padding:1rem}.archive-toolbar label{display:grid;gap:.25rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}.archive-toolbar .wide{grid-column:span 2}.archive-index-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1rem;margin-top:1rem}.archive-file-card{display:grid;gap:.65rem;padding:1rem;border:1px solid var(--line);background:var(--paper);min-width:0}.archive-file-card.selected{outline:3px solid rgba(198,255,0,.85)}.file-card-top{display:flex;justify-content:space-between;gap:.5rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}.state-badge{border:1px solid var(--line);padding:.2rem .4rem;border-radius:999px}.state-badge.available{background:#d9ffd2}.state-badge.needs_import,.state-badge.manifest_only{background:#fff2bf}.archive-thumb{width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid var(--line);background:#eee}.archive-placeholder,.file-preview-tile{display:grid;place-items:center;text-align:center;min-height:9rem;border:1px dashed var(--line);padding:1rem;background:rgba(0,0,0,.035);color:inherit;text-decoration:none}.archive-placeholder span{max-width:26ch}.path-line{font-size:.75rem;white-space:normal;overflow-wrap:anywhere}.file-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.35rem}.file-facts div{padding:.4rem;background:rgba(0,0,0,.035)}.file-facts dt{font-size:.62rem;text-transform:uppercase}.file-facts dd{margin:0;overflow-wrap:anywhere}.chip-line{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center}.quick-index-form{display:grid;gap:.5rem;border-top:1px solid var(--line);padding-top:.75rem}.quick-index-form label{display:grid;gap:.25rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}.quick-index-form textarea{min-height:4rem}.manifest-only-note{padding:.65rem;background:#fff2bf;border:1px solid #d49300}.upload-progress{display:grid;gap:.35rem;padding:1rem;background:var(--paper);border:1px solid var(--line);margin-top:1rem;max-height:16rem;overflow:auto}@media(max-width:850px){.folder-index-shell{grid-template-columns:1fr}.folder-rail{position:relative;top:auto;max-height:18rem}.archive-toolbar .wide{grid-column:span 1}.file-facts{grid-template-columns:1fr}}
  </style>
</AppLayout>

---
import { getCollection } from "astro:content";
import AppLayout from "../../layouts/AppLayout.astro";
import PipelineNav from "../../components/PipelineNav.astro";
const staticBundles = await getCollection("exportBundles");
---
<AppLayout title="Export and download bundles" section="exports">
  <PipelineNav active="exports" />
  <header class="page-head"><div class="head-copy"><p class="eyebrow">Operations / database exports</p><h1>Export / Download Bundles</h1><p class="lede">Generate current bundles from Supabase, store them in private Storage, and download them through signed URLs. GitHub/static bundles remain versioned snapshots, not the live operational source.</p></div></header>
  <section class="card pipeline-card acid">
    <div class="card-kicker">Create live export</div><h2>Generate from current database rows</h2>
    <form id="database-export-form" class="form-grid compact"><label>Bundle<select name="exportType"><option value="full-creative-os">Full Creative OS</option><option value="artifact-index">Artifact index</option><option value="public-archive">Public archive</option><option value="para-pack">Para pack</option><option value="faction-pack">Faction pack</option><option value="remediation-report">Remediation report</option><option value="decision-queue">Decision queue</option><option value="selected-files">Selected file metadata bundle</option></select></label><label>Title<input name="title" placeholder="Optional custom title" /></label><label>Reason<input name="reason" required placeholder="Why this export is needed" /></label><div class="action-row"><button class="button acid" type="submit">Generate Supabase export</button><span class="save-state"></span></div></form>
  </section>
  <div class="section-head"><h2>Live database exports</h2><button class="button secondary" id="refresh-exports" type="button">Refresh</button></div>
  <div class="grid grid-2" id="database-exports"><div class="empty-panel">Log in to load database exports.</div></div>
  <div class="section-head"><h2>Versioned static snapshots</h2><span>{staticBundles.length} build-generated definitions</span></div>
  <div class="grid grid-2">{staticBundles.map((bundle)=><article class="card bundle-card"><div><div class="card-kicker">Static snapshot · {bundle.data.exportType}</div><h3>{bundle.data.title}</h3><p>{bundle.data.notes}</p></div><a class="download-link" href={bundle.data.filePath} download>Download snapshot ↓</a></article>)}</div>
  <script is:inline>
    const esc=(value)=>String(value??'').replace(/[&<>"']/g,(character)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#039;'}[character]));const host=document.querySelector('#database-exports'),form=document.querySelector('#database-export-form'),status=form.querySelector('.save-state');
    const load=async()=>{await window.CreativeAccount.ready;if(!window.CreativeAccount.current().authenticated){host.innerHTML='<div class="empty-panel">Log in to load database exports.</div>';return;}try{const data=await window.CreativeDatabase.listExports();host.innerHTML=(data.exports||[]).map((item)=>`<article class="card bundle-card"><div><div class="card-kicker">${esc(item.export_type)} · ${esc(item.status)}</div><h3>${esc(item.title)}</h3><p>${esc(new Date(item.created_at).toLocaleString())} · ${(item.manifest?.artifactCount??0)} artifacts</p></div>${item.signedUrl?`<a class="download-link" href="${esc(item.signedUrl)}">Download ↓</a>`:`<span class="operation-error">${esc(item.storageError||'File unavailable')}</span>`}</article>`).join('')||'<div class="empty-panel">No live exports yet. Generate one above.</div>';}catch(error){host.innerHTML=`<div class="warning-panel">${esc(error.message)}</div>`;}};
    form.addEventListener('submit',async(event)=>{event.preventDefault();const data=new FormData(form);status.textContent='Generating database export…';try{const result=await window.CreativeDatabase.createExport({exportType:data.get('exportType'),title:data.get('title')||undefined,reason:data.get('reason')});status.innerHTML=`Live in Creative OS. <a href="${esc(result.export.signedUrl)}">Download ${esc(result.export.title)}</a>`;form.reset();load();}catch(error){status.textContent=`Failed. ${error.message}`;}});document.querySelector('#refresh-exports').addEventListener('click',load);window.addEventListener('creative-os-auth-changed',load);window.addEventListener('DOMContentLoaded',load);
  </script>
</AppLayout>

---
import AppLayout from "../../layouts/AppLayout.astro";
import PipelineNav from "../../components/PipelineNav.astro";
import repoManifest from "../../generated/repo-import-manifest.json";
---
<AppLayout title="Archive indexing" section="pipeline">
  <PipelineNav active="artifacts" />
  <section class="pipeline-hero">
    <p class="eyebrow">Archive</p>
    <h1>The app is centered on your folder.</h1>
    <p class="lede">Use the Archive Index to browse the Desktop <code>Archive/</code> snapshot from GitHub/Netlify, save live tags and folders in Supabase, add new files, preview, download, and export.</p>
    <div class="terminal-line">{repoManifest.counts.archiveFiles || 0} files · {repoManifest.counts.archiveFolders || 0} folders · solo archive mode</div>
    <p><a class="button acid" href="/pipeline/artifacts">Open Archive</a></p>
  </section>
</AppLayout>

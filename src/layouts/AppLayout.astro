---
import "../styles/global.css";

interface Props {
  title: string;
  section?: string;
  description?: string;
}

const { title, section = "artifacts", description = "Archive folder index" } = Astro.props;
const buildTimestamp = new Date().toISOString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} - Archive Index</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/pipeline/artifacts">
          <span class="brand-mark">AI</span>
          <span><strong>Archive Index</strong><span>Folders, files, tags</span></span>
        </a>

        <div class="nav-label">Current app</div>
        <a class:list={["nav-link", section === "artifacts" && "active"]} href="/pipeline/artifacts">Archive</a>

        <section class="account-panel" aria-label="Archive operator" data-build-timestamp={buildTimestamp}>
          <div class="nav-label">Authority</div>
          <b data-account-state>Checking authentication…</b>
          <p data-account-name>Not signed in</p>
          <dl class="account-facts">
            <dt>Email</dt><dd data-account-email>—</dd>
            <dt>Role</dt><dd data-account-role>viewer</dd>
            <dt>Role source</dt><dd data-account-role-source>Waiting for a verified Netlify Identity session</dd>
            <dt>Privileges</dt><dd data-account-privileges>not elevated</dd>
          </dl>
          <p data-account-authority>No application authority</p>
          <p data-emergency-state>No automatic owner or emergency fallback is active.</p>
          <p data-account-auto>Sign in with contributor authority or higher to change Creative OS state.</p>
          <button class="button acid" type="button" data-account-login>Sign in</button>
          <button class="button" type="button" data-account-logout hidden>Sign out</button>
          <form class="identity-invite-form" data-invite-form hidden>
            <p>Finish accepting your Creative OS invitation.</p>
            <label>
              New password
              <input type="password" autocomplete="new-password" required data-invite-password />
            </label>
            <label>
              Confirm password
              <input type="password" autocomplete="new-password" required data-invite-password-confirmation />
            </label>
            <button class="button acid" type="submit">Accept invitation</button>
          </form>
          <a class="button" href="/pipeline/artifacts" data-admin-portal-status>View sign-in status</a>
          <details class="deploy-status">
            <summary>Creative OS runtime readiness</summary>
            <dl>
              <dt>Build</dt><dd data-deploy-build>{buildTimestamp}</dd>
              <dt>Branch</dt><dd data-deploy-branch>checking...</dd>
              <dt>Auth mode</dt><dd data-deploy-auth>checking…</dd>
              <dt>Database API</dt><dd data-deploy-api>checking...</dd>
              <dt>Runtime context</dt><dd data-health-context>checking...</dd>
              <dt>Project identity</dt><dd data-health-project>checking...</dd>
              <dt>Schema contract</dt><dd data-health-contract>checking...</dd>
              <dt>Required schema</dt><dd data-health-schema>checking...</dd>
              <dt>Storage buckets</dt><dd data-health-buckets>checking...</dd>
              <dt>Mutation authority</dt><dd data-health-authority>checking...</dd>
              <dt>Routine GitHub writes</dt><dd data-deploy-github>disabled</dd>
            </dl>
            <p data-health-status></p>
          </details>
        </section>

        <div class="sidebar-foot"><b>Archive Index</b><br/>Virtual folders.<br/>Standard + freeform tags.</div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="breadcrumbs">Archive - {section}</div>
          <div class="mode-switch">
            <a class="active" href="/pipeline/artifacts">Index</a>
          </div>
        </header>
        <div class="content"><slot /></div>
      </main>

      <nav class="mobile-nav">
        <a class="active" href="/pipeline/artifacts">Archive</a>
      </nav>
    </div>
    <script>import "../scripts/account-client.js"; import "../scripts/creative-os-client.js";</script>
  </body>
</html>

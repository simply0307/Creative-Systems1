---
import "../styles/global.css";

interface Props {
  title: string;
  section?: string;
  description?: string;
}

const { title, section = "artifacts", description = "Archive folder index" } = Astro.props;
const buildTimestamp = new Date().toISOString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} - Archive Index</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/pipeline/artifacts">
          <span class="brand-mark">AI</span>
          <span><strong>Archive Index</strong><span>Folders, files, tags</span></span>
        </a>

        <div class="nav-label">Current app</div>
        <a class:list={["nav-link", section === "artifacts" && "active"]} href="/pipeline/artifacts">Archive</a>

        <section class="account-panel" aria-label="Archive operator" data-build-timestamp={buildTimestamp}>
          <div class="nav-label">Authority</div>
          <b data-account-state>Solo archive mode</b>
          <p data-account-name>Archive operator</p>
          <dl class="account-facts">
            <dt>Email</dt><dd data-account-email>archive-operator@creative-os.local</dd>
            <dt>Role</dt><dd data-account-role>owner</dd>
            <dt>Role source</dt><dd data-account-role-source>Solo user mode</dd>
            <dt>Privileges</dt><dd data-account-privileges>owner active</dd>
          </dl>
          <p data-account-authority>Full archive indexing authority</p>
          <p data-emergency-state>No account gate for solo-user mode.</p>
          <p data-account-auto>Tag, folder, category, import, and export actions are available.</p>
          <a class="button acid" href="/pipeline/artifacts" data-admin-portal-status>Open Archive</a>
          <details class="deploy-status">
            <summary>Supabase / setup health</summary>
            <dl>
              <dt>Build</dt><dd data-deploy-build>{buildTimestamp}</dd>
              <dt>Branch</dt><dd data-deploy-branch>checking...</dd>
              <dt>Auth mode</dt><dd data-deploy-auth>solo mode</dd>
              <dt>Database API</dt><dd data-deploy-api>checking...</dd>
              <dt>Supabase URL</dt><dd data-health-url>checking...</dd>
              <dt>Anon key</dt><dd data-health-anon>checking...</dd>
              <dt>Service role</dt><dd data-health-service>checking...</dd>
              <dt>Database connection</dt><dd data-health-database>checking...</dd>
              <dt>Artifact read</dt><dd data-health-artifacts>checking...</dd>
              <dt>Storage buckets</dt><dd data-health-buckets>checking...</dd>
              <dt>Detected role</dt><dd data-health-role>owner</dd>
              <dt>Audit write</dt><dd data-health-audit>not verified</dd>
              <dt>Routine GitHub writes</dt><dd data-deploy-github>disabled</dd>
            </dl>
            <button class="button secondary" type="button" data-health-audit-probe hidden>Run audit write probe</button>
            <p data-health-status></p>
          </details>
        </section>

        <div class="sidebar-foot"><b>Archive Index</b><br/>Virtual folders.<br/>Standard + freeform tags.</div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="breadcrumbs">Archive - {section}</div>
          <div class="mode-switch">
            <a class="active" href="/pipeline/artifacts">Index</a>
          </div>
        </header>
        <div class="content"><slot /></div>
      </main>

      <nav class="mobile-nav">
        <a class="active" href="/pipeline/artifacts">Archive</a>
      </nav>
    </div>
    <script>import "../scripts/account-client.js"; import "../scripts/creative-os-client.js";</script>
  </body>
</html>
